diff -ruN '--exclude=__pycache__' a/srt/layers/ablit_dual.py b/srt/layers/ablit_dual.py
--- a/srt/layers/ablit_dual.py	1969-12-31 17:00:00.000000000 -0700
+++ b/srt/layers/ablit_dual.py	2026-10-27 00:51:37.905395009 -0700
@@ -0,0 +1,127 @@
+"""Dual-variant (stock + abliterated) support for DeepSeek-V4.1-Flash.
+
+The abliterated variant is not a second weight set: the overlay removes one direction
+from attention output across layers 10-35, i.e.
+
+    y' = y - lambda_l * (r . y) * r          (r shared, lambda_l per layer)
+
+Measured against the published overlay this reproduces the artifact to within its own
+FP8 quantisation noise (residual 1.96% of |A|, 84% of FP8 bytes identical), so the edit
+can be applied at runtime on top of the unmodified stock weights.
+
+Per-request selection is a per-token mask supplied by the batch; stock traffic gets
+mask 0 and is therefore an exact no-op (y - 0*x is bitwise y).
+"""
+from __future__ import annotations
+
+import json
+import os
+from typing import Optional
+
+import torch
+
+_ARTIFACT = "ablit_direction.safetensors"
+_META = "ablit_direction.json"
+LAYER_LO, LAYER_HI = 10, 35
+
+
+class AblitDirection:
+    """r + per-layer lambda, loaded once per process (per TP rank) from a read-only dir."""
+
+    def __init__(self, path: str):
+        from safetensors.torch import load_file
+
+        with open(os.path.join(path, _META)) as f:
+            meta = json.load(f)
+        order = meta.get("lambda_layer_order") or (meta.get("hook") or {}).get(
+            "lambda_layer_order"
+        )
+        if order is None:
+            tag = meta.get("lambda_layers")
+            order = (
+                list(range(LAYER_LO, LAYER_HI + 1))
+                if tag == f"{LAYER_LO}-{LAYER_HI}"
+                else None
+            )
+        if order != list(range(LAYER_LO, LAYER_HI + 1)):
+            raise ValueError(f"unexpected lambda_layer_order={order!r}")
+
+        t = load_file(os.path.join(path, _ARTIFACT))
+        self.r = t["r"].float()
+        self.lam = t["lambda"].float()
+        if self.lam.numel() != LAYER_HI - LAYER_LO + 1:
+            raise ValueError(f"expected 26 lambdas, got {self.lam.numel()}")
+        if self.r.ndim != 1 or self.r.numel() == 0:
+            raise ValueError("r must be a non-empty vector")
+        self._cache: dict[tuple[str, torch.dtype], torch.Tensor] = {}
+        prov = meta.get("provenance") or {}
+        self.provenance = (
+            f"{prov.get('overlay_repo', '?')}@{prov.get('overlay_revision_short', '?')}"
+            if isinstance(prov, dict)
+            else str(prov)
+        )
+
+    def _vec(self, dtype: torch.dtype, device: torch.device) -> torch.Tensor:
+        key = (str(device), dtype)
+        v = self._cache.get(key)
+        if v is None:
+            v = self.r.to(device=device, dtype=dtype)
+            self._cache[key] = v
+        return v
+
+    def apply(self, y: torch.Tensor, mask: Optional[torch.Tensor], layer: int) -> torch.Tensor:
+        """Masked rank-1 projection. mask=None or all-zero is a bitwise no-op.
+
+        y: [tokens, hidden] attention output. mask: [tokens] bool/float, or None.
+        Graph-safe: static shapes, no host synchronisation, no Python branch on values.
+        """
+        if layer < LAYER_LO or layer > LAYER_HI:
+            return y
+        r = self._vec(y.dtype, y.device)
+        proj = torch.mv(y, r)
+        if mask is not None:
+            # Rows must match: a batch path that shards or tails rows (SP, late-layer bounded
+            # replay) has to slice the mask alongside the hidden states first. Fail loudly with
+            # both sizes instead of a bare broadcast error.
+            if mask.numel() != proj.numel():
+                raise RuntimeError(
+                    f"ablit hook: mask has {mask.numel()} rows but the attention output has "
+                    f"{proj.numel()} (layer {layer}); the batch path sharded or tailed rows "
+                    f"without slicing forward_batch.ablit_mask"
+                )
+            proj = proj * mask.to(proj.dtype)
+        lam = float(self.lam[layer - LAYER_LO])
+        return y - (lam * proj).unsqueeze(-1) * r
+
+    def reference(self, y: torch.Tensor, mask: Optional[torch.Tensor], layer: int) -> torch.Tensor:
+        """fp32 reference used only by tests."""
+        r = self.r.to(y.device)
+        proj = y.float() @ r
+        if mask is not None:
+            proj = proj * mask.float()
+        return (
+            y.float() - float(self.lam[layer - LAYER_LO]) * proj.unsqueeze(-1) * r
+        ).to(y.dtype)
+
+
+_DIR: Optional[AblitDirection] = None
+
+
+def enabled() -> bool:
+    return os.environ.get("DSV41_DUAL_VARIANT", "0") not in ("", "0", "false", "False")
+
+
+def direction() -> Optional[AblitDirection]:
+    global _DIR
+    if not enabled():
+        return None
+    if _DIR is None:
+        _DIR = AblitDirection(os.environ.get("DSV41_ABLIT_DIR", "/ablit"))
+    return _DIR
+
+
+def apply_hook(y: torch.Tensor, mask: Optional[torch.Tensor], layer: int) -> torch.Tensor:
+    d = direction()
+    if d is None:
+        return y
+    return d.apply(y, mask, layer)
